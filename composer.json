{
    "name": "dmlab/module-price-explain",
    "description": "Explains why a Magento 2 cart or order costs what it costs: item price layers, totals collectors, cart price rules (applied or rejected with the reason) and tax.",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "cart price rules",
        "catalog price rules",
        "coupon",
        "discount",
        "tax",
        "price debugging",
        "totals",
        "cart rule debugging",
        "coupon not applied"
    ],
    "type": "magento2-module",
    "license": "OSL-3.0",
    "homepage": "https://github.com/dmlab-work/module-price-explain",
    "support": {
        "issues": "https://github.com/dmlab-work/module-price-explain/issues",
        "source": "https://github.com/dmlab-work/module-price-explain"
    },
    "version": "0.0.2",
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.7",
        "magento/module-backend": "^102.0.7",
        "magento/module-catalog": "^104.0.7",
        "magento/module-catalog-rule": "^101.2.7",
        "magento/module-customer": "^103.0.7",
        "magento/module-quote": "^101.2.7",
        "magento/module-rule": "^100.4.6",
        "magento/module-sales": "^103.0.7",
        "magento/module-sales-rule": "^101.2.7",
        "magento/module-store": "^101.1.7",
        "magento/module-tax": "^100.4.7",
        "symfony/console": "^6.4||^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\PriceExplain\\": ""
        }
    }
}
