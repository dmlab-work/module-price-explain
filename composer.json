{
    "name": "dmlab/module-price-explain",
    "description": "Explains why a Magento 2 cart or order costs what it costs: item price layers, totals collectors, cart price rules (applied or rejected with the reason) and tax.",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "cart price rules",
        "catalog price rules",
        "coupon",
        "discount",
        "tax",
        "price debugging",
        "totals"
    ],
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "0.0.1",
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.9",
        "magento/module-backend": "^102.0.9",
        "magento/module-catalog": "^104.0.9",
        "magento/module-catalog-rule": "^101.2.9",
        "magento/module-customer": "^103.0.9",
        "magento/module-quote": "^101.2.9",
        "magento/module-rule": "^100.4.8",
        "magento/module-sales": "^103.0.9",
        "magento/module-sales-rule": "^101.2.9",
        "magento/module-store": "^101.1.9",
        "magento/module-tax": "^100.4.9",
        "symfony/console": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\PriceExplain\\": ""
        }
    }
}
